enabled = true;

# Multi-group policy.
# Each group key is resolved to a GID via getgrnam(3).
# Use "template" to reference /usr/local/etc/autodo/templates/<name>.conf,
# or define inline scope/deny blocks.
groups {
    wheel {
        template = "all";
    }
    # developers {
    #     template = "developer";
    # }
    # operators {
    #     template = "server-admin";
    # }
    # restricted {
    #     scope {
    #         categories = ["vfs"];
    #     }
    #     deny {
    #         privileges = ["PRIV_VFS_MOUNT", "PRIV_VFS_UNMOUNT"];
    #     }
    # }
}

# Legacy single-scope mode (used when "groups" block is absent).
# scope {
#     categories = ["all"];
# }

# Global path deny list (advisory "OS file protection").
# Non-root members of managed groups are denied create/delete/rename/
# mkdir under these absolute prefixes, and write/chmod/chown of the
# resolved files — even when autodo would otherwise grant them.
# Root is exempt, reads are unaffected.  This is footgun protection,
# not a security boundary: relative paths from inside a denied
# directory and fd-based operations (fchmod etc.) are not covered.
# deny {
#     paths = ["/boot/kernel", "/bin", "/sbin", "/usr/bin", "/usr/sbin",
#              "/lib", "/libexec"];
# }

audit {
    enabled = true;
    log_file = "/var/log/autodo/events.json";
}

# template_dir = "/usr/local/etc/autodo/templates";
